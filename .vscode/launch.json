{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Analyzer on Combined Bundle",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "tests/dev_bundles/escalation_combined.yaml",
                "-o",
                "sample_report.json"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run Analyzer (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "tests/dev_bundles/escalation_combined.yaml"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run All Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "tests"
            ],
            "console": "integratedTerminal"
        }
    ]
}
